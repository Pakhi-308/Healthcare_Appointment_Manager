# ==============================================================================
# Healthcare Appointment & Follow-up Manager - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
PORT=8000
FRONTEND_URL=http://localhost:5173

# Database Connection (MySQL / SQLite fallback for development)
# For MySQL: mysql+pymysql://root:password@localhost:3306/healthcare_db
# For SQLite (Dev fallback): sqlite:///./healthcare.db
DATABASE_URL=sqlite:///./healthcare.db

# JWT Security
SECRET_KEY=change_this_to_a_secure_random_secret_in_production_32_bytes_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Groq API (LLaMA 3.3 70B)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Email Service Configuration (fastapi-mail / SMTP)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=noreply@healthsync.care
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME="HealthSync Portal"
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
USE_CREDENTIALS=True
VALIDATE_CERTS=True

# Google Calendar OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/calendar/oauth2callback

# Admin Initial Seed
ADMIN_EMAIL=admin@healthsync.care
ADMIN_PASSWORD=AdminPassword123!
ADMIN_NAME="System Administrator"
